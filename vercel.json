{
  "version": 2,
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "^/assets/(.*)$",
      "dest": "/client/assets/$1"
    },
    {
      "src": "^/(.*\\.(png|jpg|jpeg|svg|ico|txt|json|webmanifest|woff2?|woff|map))$",
      "dest": "/client/$1"
    },
    {
      "src": "^/(.*)$",
      "dest": "/api/index.ts"
    }
  ]
}
